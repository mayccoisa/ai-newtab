{
  "name": "ai-homepage",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "pnpm --filter @homepage/extension build",
    "dev": "pnpm --filter @homepage/extension dev",
    "bridge": "pnpm --filter @homepage/bridge start",
    "typecheck": "pnpm -r typecheck",
    "test": "bun test harness/ && pnpm --filter @homepage/bridge test",
    "home:verify": "bun harness/verify-homepage.ts",
    "extension:test": "bun harness/test-extension.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
